{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "where_im_at",
    "focus",
    "extra_needs",
    "resolved",
    "brief"
  ],
  "properties": {
    "where_im_at": {
      "type": "string"
    },
    "focus": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why",
          "owner"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "extra_needs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail",
          "tag",
          "owner"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "enum": [
              "task",
              "decision",
              "todo",
              "routine",
              "deadline",
              "system"
            ]
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "resolved": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "acts",
        "notes"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "acts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "range",
              "text"
            ],
            "properties": {
              "range": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
